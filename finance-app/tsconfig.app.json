{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict mode — допомагає ловити помилки на етапі компіляції */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,

    /* Path aliases — @ замість відносних шляхів */
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // sw.ts живе в іншому глобальному контексті (ServiceWorkerGlobalScope,
  // lib "webworker") — конфліктує з DOM lib решти застосунку (напр. тип
  // `self`). vite-plugin-pwa (injectManifest) транспілює й типізує його
  // окремо через tsconfig.sw.json, тут із перевірки типів виключаємо.
  "exclude": ["src/sw.ts"]
}
