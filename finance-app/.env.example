# Скопіюй цей файл в .env і заповни своїми значеннями з Supabase Dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Публічний VAPID-ключ для push-сповіщень про регулярні платежі —
# сгенеруй пару (напр. `npx web-push generate-vapid-keys`), приватний
# іде в секрет Edge Function VAPID_PRIVATE_KEY (Dashboard → Edge
# Functions → Secrets), НЕ сюди. Без цієї змінної свіч "Зробити
# регулярним" далі працює (транзакція генерується), просто без push.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
